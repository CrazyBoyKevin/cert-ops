DATABASE_URL=postgresql://certops:replace-with-a-strong-password@127.0.0.1:5432/certops
CERT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-random-cron-token
CERTOPS_ADMIN_USERNAME=admin
CERTOPS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CERTOPS_SESSION_SECRET=replace-with-at-least-32-random-characters
# Disable only if an external scheduler calls POST /api/cron/acme.
ACME_SCHEDULER_ENABLED=true
# Management console TLS (0.1.0+; port is bound after certificate upload).
CERTOPS_HTTPS_PORT=9443
CERTOPS_DATA_DIR=./data
# Emergency recovery only, on an isolated network. Remove and restart after repair.
# CERTOPS_HTTPS_RECOVERY=true
